{
  "name": "fynvra",
  "version": "0.1.0",
  "private": true,
  "description": "Fynvra - local desktop AI coding workspace with built-in multi-agent orchestration",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "package:mac": "pnpm build && electron-builder --config electron-builder.mac-manual.yml --mac --x64 --arm64 --publish never",
    "package:mac:signed": "pnpm build && electron-builder --mac --x64 --arm64 --publish never",
    "release:plan": "node scripts/release.ts plan",
    "release:verify": "node scripts/release.ts verify",
    "test:updates": "node scripts/verify-updates.cjs",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web && pnpm typecheck:packages",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:packages": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/agent-runtime",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@biomejs/biome": "2.6.2",
    "@codemirror/language-data": "^6.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.19",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1",
    "zustand": "^5.0.16"
  }
}
