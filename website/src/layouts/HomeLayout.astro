---
import { homeCopy, type Locale } from '../content/home/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = homeCopy[locale];
// Only configured production origins produce canonical URLs. Astro.url may be localhost.
const languageUrl = (language: Locale) =>
  Astro.site ? new URL(`/${language}/`, Astro.site).href : `/${language}/`;
const canonical = Astro.site ? languageUrl(locale) : undefined;
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'} data-locale={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    <meta name="theme-color" content="#f7f6f2" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={copy.title} />
    <meta property="og:description" content={copy.ogDescription} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" hreflang="zh-CN" href={languageUrl('zh')} />
    <link rel="alternate" hreflang="en" href={languageUrl('en')} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Keep the theme bootstrap synchronous, and the demo controller after parsing the DOM. -->
    <script is:inline src="/assets/site.js"></script>
    <link rel="stylesheet" href="/assets/site.css" />
    <link rel="stylesheet" href="/assets/home.css" />
    <link rel="stylesheet" href="/assets/demo.css" />
    <script is:inline src="/assets/home.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main"><span>{copy.skipLink}</span></a>
    <slot />
  </body>
</html>
