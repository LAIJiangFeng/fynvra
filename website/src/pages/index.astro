---
import { entryRedirectScript } from '../lib/compatibility';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Fynvra — 选择语言 / Choose a language</title>
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <script is:inline set:html={entryRedirectScript('home')} />
  </head>
  <body data-pagefind-ignore>
    <main>
      <h1>Fynvra</h1>
      <p>正在前往官网。也可以选择语言：</p>
      <p lang="en">Opening the website. You can also choose a language:</p>
      <nav aria-label="选择语言 / Choose a language">
        <a href="/zh/" lang="zh-CN" hreflang="zh-CN">进入中文首页</a>
        <a href="/en/" lang="en" hreflang="en">English home</a>
      </nav>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    padding: 3rem 1.5rem;
    font: 1rem/1.6 system-ui, sans-serif;
    color: #e8e8ec;
    background: #111116;
  }
  main { max-width: 38rem; margin: 10vh auto; }
  nav { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
  a { color: #b6a3ff; text-underline-offset: 0.2em; }
</style>
