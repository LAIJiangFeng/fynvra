---
export function getStaticPaths() {
  return (['zh', 'en'] as const).map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

interface Props {
  locale: 'zh' | 'en';
}

const { locale } = Astro.props;
const isEnglish = locale === 'en';
const destination = `/${locale}/docs/overview/`;
---

<!doctype html>
<html lang={isEnglish ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>{isEnglish ? 'Fynvra — Documentation' : 'Fynvra — 文档入口'}</title>
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </head>
  <body data-pagefind-ignore>
    <main>
      <h1>{isEnglish ? 'Fynvra documentation' : 'Fynvra 文档'}</h1>
      <p>{isEnglish ? 'Opening the documentation overview.' : '正在前往文档概览。'}</p>
      <a href={destination}>{isEnglish ? 'Read the docs' : '进入文档'}</a>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    padding: 3rem 1.5rem;
    font: 1rem/1.6 system-ui, sans-serif;
    color: #e8e8ec;
    background: #111116;
  }
  main { max-width: 38rem; margin: 10vh auto; }
  a { color: #b6a3ff; text-underline-offset: 0.2em; }
</style>
