---
import DefaultSocialIcons from '@astrojs/starlight/components/SocialIcons.astro';

const isEnglish = Astro.locals.starlightRoute.locale === 'en';
---

<DefaultSocialIcons />
<a class="download" href="https://github.com/LAIJiangFeng/fynvra/releases">
  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
  </svg>
  {isEnglish ? 'Download' : '下载'}
</a>

<style>
  .download {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 16px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: var(--fynvra-button-bg);
    color: var(--fynvra-button-ink);
    font-size: 14px;
    font-weight: 650;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s;
  }
  .download:hover {
    background: color-mix(in srgb, var(--fynvra-button-bg) 88%, var(--fynvra-ink-3));
  }
</style>
