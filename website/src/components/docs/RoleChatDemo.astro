---
import { prompts, type DemoLocale } from "./prompts";

interface Props {
  locale: DemoLocale;
}

const { locale } = Astro.props;
---

<figure
  class="docs-demo not-content"
  data-pagefind-ignore
  data-demo="roles"
  aria-label={locale === "zh" ? "界面演示：选定角色后直接对话" : "Interface demo: talk to a selected role"}
>
  <div class="fd-app" data-demo-app>
    <div class="fd-titlebar">
      <div class="fd-title-left">
        <span class="fd-tb-icon" aria-hidden="true">
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M9 4v16M15 9l-3 3 3 3" /></svg>
        </span>
        <span class="fd-brand">Fynvra</span><span class="fd-slash">/</span><span class="fd-workspace-name">fynvra</span>
      </div>
      <div class="fd-title-right" aria-hidden="true">
        <span class="fd-tb-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21h-4v-.09A1.7 1.7 0 0 0 8.5 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3v-4h.09A1.7 1.7 0 0 0 4.6 8.5a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3h4v.09A1.7 1.7 0 0 0 15.5 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.4 9c.15.38.36.72.6 1 .3.3.68.44 1.1.4H21v4h-.09a1.7 1.7 0 0 0-1.51.6Z" /></svg></span>
        <span class="fd-tb-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" /></svg></span>
        <span class="fd-tb-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M15 4v16M10 9l-3 3 3 3" /></svg></span>
        <span class="fd-window-controls">
          <span class="fd-wc"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg></span>
          <span class="fd-wc"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="5" width="14" height="14" /></svg></span>
          <span class="fd-wc"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></span>
        </span>
      </div>
    </div>
    <div class="fd-scene" id="fd-scene-roles" data-scene="roles" data-phase="0">
      <div class="fd-body">
        <aside class="fd-side">
          <div class="fd-side-head">
            {locale === "zh" && (<span>工作区</span>)}{locale === "en" && (<span>Workspaces</span>)}
            <span class="fd-side-actions" aria-hidden="true">
              <span class="fd-mini-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
            </span>
          </div>

          <div class="fd-workspace">
            <div class="fd-ws-row">
              <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /></svg>
              <span>fynvra</span><span class="fd-ws-branch">main</span>
            </div>
            <p class="fd-ws-path">D:\project\fynvra</p>

            <div class="fd-sessions-head">
              {locale === "zh" && (<span>会话</span>)}{locale === "en" && (<span>Sessions</span>)}
              <span class="fd-side-actions" aria-hidden="true">
                <span class="fd-mini-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4-4" /></svg></span>
                <span class="fd-mini-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
              </span>
            </div>

            <div class="fd-session is-idle" data-session="role-worker" data-appear="1">
              <span class="fd-dot is-run"></span>
              <span class="fd-session-main">
                <span class="fd-session-title">{locale === "zh" && (<span>设置页：侧栏折叠</span>)}{locale === "en" && (<span>Settings: sidebar collapse</span>)}</span>
                <span class="fd-session-sub">
                  <span class="fd-role">Worker</span>
                  <span class="fd-model-tag">DeepSeek</span>
                </span>
              </span>
            </div>

            <div class="fd-session is-idle" data-session="role-review" data-appear="5">
              <span class="fd-dot is-run"></span>
              <span class="fd-session-main">
                <span class="fd-session-title">{locale === "zh" && (<span>审查侧栏折叠</span>)}{locale === "en" && (<span>Review sidebar collapse</span>)}</span>
                <span class="fd-session-sub">
                  <span class="fd-role is-custom">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4-4" /><path d="m8 11 2 2 4-4" /></svg>
                    {locale === "zh" && (<span>代码审查员</span>)}{locale === "en" && (<span>Code reviewer</span>)}
                    <span class="fd-role-custom">{locale === "zh" && (<span>自定义</span>)}{locale === "en" && (<span>Custom</span>)}</span>
                  </span>
                </span>
              </span>
            </div>
          </div>
        </aside>

        <div class="fd-main">
          <div class="fd-editor-tabs" aria-hidden="true">
            <span class="fd-editor-tab is-active">{locale === "zh" && (<span>对话</span>)}{locale === "en" && (<span>Chat</span>)}</span>
            <span class="fd-editor-tab">Settings.tsx</span>
            <span class="fd-editor-tab">SettingsSidebar.tsx</span>
            <span class="fd-editor-tab">settings.css</span>
            <span class="fd-editor-add"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
          </div>

          <div class="fd-chat-head is-idle" data-role-head data-state="idle">
            <span class="fd-dot is-run"></span>
            <span class="fd-chat-title" data-role-title="worker" hidden>{locale === "zh" && (<span>Worker · 设置页侧栏折叠</span>)}{locale === "en" && (<span>Worker · Settings sidebar collapse</span>)}</span>
            <span class="fd-chat-title" data-role-title="review" hidden>{locale === "zh" && (<span>代码审查员 · 审查侧栏折叠</span>)}{locale === "en" && (<span>Code reviewer · Review sidebar collapse</span>)}</span>
            <span class="fd-role" data-role-chip="worker" hidden>Worker</span>
            <span class="fd-role is-custom" data-role-chip="review" hidden>
              <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4-4" /><path d="m8 11 2 2 4-4" /></svg>
              {locale === "zh" && (<span>代码审查员</span>)}{locale === "en" && (<span>Code reviewer</span>)}
              <span class="fd-role-custom">{locale === "zh" && (<span>自定义</span>)}{locale === "en" && (<span>Custom</span>)}</span>
            </span>
            <span class="fd-chip"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4v10a3 3 0 0 0 3 3h9M15 14l3 3-3 3M6 4v4" /></svg>main</span>
            <span class="fd-chat-status">
              <span class="fd-st-run">{locale === "zh" && (<span>运行中</span>)}{locale === "en" && (<span>Running</span>)}</span>
              <span class="fd-st-idle">{locale === "zh" && (<span>空闲</span>)}{locale === "en" && (<span>Idle</span>)}</span>
            </span>
          </div>

          <div class="fd-timeline" data-timeline>
            <div class="fd-stream" data-role-chat="worker">
              <div class="fd-empty" data-empty hidden>
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 0 1-8 8H5l-2 2V12a8 8 0 0 1 8-8h2a8 8 0 0 1 8 8Z" /></svg>
                {locale === "zh" && (<span>已创建 Worker 会话，直接写明需求，不需要主 Agent 转交。</span>)}
                {locale === "en" && (<span>Worker session created. Ask it directly — no main agent handoff.</span>)}
              </div>

              <div class="fd-msg is-user" data-appear="3">
                <span data-demo-user="role-worker" data-demo-lang={locale}>{prompts["role-worker"][locale]}</span>

              </div>

              <div class="fd-msg fd-agent" data-appear="3">
                {locale === "zh" && (<p>已加上设置页侧栏折叠：折叠后只保留图标栏，展开/收起时内容区跟着调整，窄屏也能正常展开；折叠状态写入本地设置，刷新后保持。改了 3 个文件：<code>src/renderer/settings/Settings.tsx</code>（折叠按钮与状态读写）、<code>src/renderer/settings/SettingsSidebar.tsx</code>（图标栏布局）、<code>src/renderer/settings/settings.css</code>（宽度与窄屏样式）。</p>)}
                {locale === "en" && (<p>Added sidebar collapse to the settings page: when collapsed only the icon rail remains, the content area resizes with it, and narrow screens still expand correctly. The collapse state is saved locally and survives reloads. Changed 3 files: <code>src/renderer/settings/Settings.tsx</code> (collapse button and state read/write), <code>src/renderer/settings/SettingsSidebar.tsx</code> (icon rail layout), and <code>src/renderer/settings/settings.css</code> (widths and narrow-screen styles).</p>)}
              </div>
            </div>

            <div class="fd-stream" data-role-chat="review" hidden>
              <div class="fd-empty" data-role-empty>
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4-4" /><path d="m8 11 2 2 4-4" /></svg>
                {locale === "zh" && (<span>审查会话只读：列出问题与建议，不改文件。</span>)}
                {locale === "en" && (<span>Read-only review: list issues and suggestions, never edit files.</span>)}
              </div>

              <div class="fd-msg is-user" data-appear="6">
                <span data-demo-user="role-review" data-demo-lang={locale}>{prompts["role-review"][locale]}</span>

              </div>

              <div class="fd-msg fd-agent" data-appear="6">
                {locale === "zh" && (<p><strong>问题</strong></p>)}
                {locale === "en" && (<p><strong>Issues</strong></p>)}
                <ul class="fd-role-bullets">
                  <li>{locale === "zh" && (<span><code>SettingsSidebar.tsx</code> 用不可聚焦的 <code>div</code> 模拟折叠按钮，只有 click 处理，无法通过键盘激活。</span>)}{locale === "en" && (<span>The collapse control in <code>SettingsSidebar.tsx</code> is a non-focusable <code>div</code> with only a click handler, so it cannot be activated from the keyboard.</span>)}</li>
                  <li>{locale === "zh" && (<span><code>Settings.tsx</code> 读取本地折叠状态时没有默认值，旧配置会读到 undefined。</span>)}{locale === "en" && (<span><code>Settings.tsx</code> reads the local collapse state without a fallback; older configs get undefined.</span>)}</li>
                  <li>{locale === "zh" && (<span><code>settings.css</code> 把图标栏宽度写死为 56px，窄屏展开时内容会和图标重叠。</span>)}{locale === "en" && (<span><code>settings.css</code> hard-codes a 56px icon rail, so content overlaps when expanded on narrow screens.</span>)}</li>
                </ul>
                {locale === "zh" && (<p><strong>建议</strong></p>)}
                {locale === "en" && (<p><strong>Suggestions</strong></p>)}
                <ul class="fd-role-bullets">
                  <li>{locale === "zh" && (<span>使用原生 <code>button</code> 或补 keydown，并同步 <code>aria-expanded</code>。</span>)}{locale === "en" && (<span>Use a native <code>button</code> or add keydown handling, and keep <code>aria-expanded</code> in sync.</span>)}</li>
                  <li>{locale === "zh" && (<span>读取时用默认值兜底，并补一个本地状态版本号，避免旧值失效。</span>)}{locale === "en" && (<span>Default the value on read and add a version to the stored state so old values can be ignored safely.</span>)}</li>
                  <li>{locale === "zh" && (<span>图标栏宽度改成变量，在 320px 展开态让内容换行。</span>)}{locale === "en" && (<span>Drive the rail width from a variable and let content wrap in the 320px expanded state.</span>)}</li>
                </ul>
                {locale === "zh" && (<p class="fd-role-conclusion">只读审查完成：未修改文件，也未提交。</p>)}
                {locale === "en" && (<p class="fd-role-conclusion">Read-only review done: no files modified and nothing committed.</p>)}
              </div>
            </div>
          </div>

          <div class="fd-composer">
            <div class="fd-composer-box">
              <div class="fd-composer-input">
                <span data-typed></span><span class="fd-caret" aria-hidden="true"></span>
                <span class="fd-placeholder">
                  <span data-role-placeholder="worker">{locale === "zh" && (<span>向 Worker 发送消息，Enter 发送</span>)}{locale === "en" && (<span>Message the Worker, Enter to send</span>)}</span>
                  <span data-role-placeholder="review" hidden>{locale === "zh" && (<span>向代码审查员发送消息，Enter 发送</span>)}{locale === "en" && (<span>Message the code reviewer, Enter to send</span>)}</span>
                </span>
              </div>
              <div class="fd-composer-bar">
                <span class="fd-composer-tools">
                  <span class="fd-mini-btn" aria-hidden="true"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 5h6M19 2v6" /><path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7.5" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /><circle cx="9" cy="9" r="2" /></svg></span>
                  <span class="fd-chip fd-chip-model"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect width="16" height="16" x="4" y="4" rx="2" /><rect width="6" height="6" x="9" y="9" rx="1" /><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" /></svg><span class="fd-chip-label">deepseek-v4.1-flash · high</span></span>
                  <span class="fd-chip fd-chip-approval"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" /><path d="m8 12 3 3 5-5" /></svg>{locale === "zh" && (<span>完全放行</span>)}{locale === "en" && (<span>Full access</span>)}</span>
                </span>
                <span class="fd-send" data-send><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.714 3.048a.498.498 0 0 0-.683.627l2.843 7.627a2 2 0 0 1 0 1.396l-2.842 7.627a.498.498 0 0 0 .682.627l18-8.5a.5.5 0 0 0 0-.904z" /><path d="M6 12h16" /></svg>{locale === "zh" && (<span>发送</span>)}{locale === "en" && (<span>Send</span>)}</span>
              </div>
            </div>
          </div>

          <div class="fd-statusbar" aria-hidden="true">
            <span>tokens ↑8.6k ↓2.1k</span><span>$0.03</span>
            <span class="fd-status-right">
              <span class="is-amber"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" /></svg>{locale === "zh" && (<span>完全放行</span>)}{locale === "en" && (<span>Full</span>)}</span>
              <span><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4v10a3 3 0 0 0 3 3h9M15 14l3 3-3 3M6 4v4" /></svg>main</span>
              <span>deepseek-v4.1-flash</span>
            </span>
          </div>
        </div>

        <aside class="fd-panel">
          <div class="fd-panel-head">
            <div class="fd-panel-tabs">
              <span class="fd-panel-tab is-active">
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3" /><path d="M3 20a6 6 0 0 1 12 0M16 5.5a3 3 0 0 1 0 5.6M18 14a5 5 0 0 1 3 4.6" /></svg>
                {locale === "zh" && (<span>角色</span>)}{locale === "en" && (<span>Roles</span>)}
              </span>
            </div>
          </div>

          <div class="fd-panel-body">
            <div class="fd-role-card" data-role-card="worker" data-state="idle">
              <div class="fd-role-card-head">
                <span class="fd-role-card-name">Worker</span>
                <span class="fd-role">{locale === "zh" && (<span>开发</span>)}{locale === "en" && (<span>Build</span>)}</span>
              </div>
              {locale === "zh" && (<p>直接实现你提出的改动，交付代码与结果。</p>)}
              {locale === "en" && (<p>Implements the change you ask for and delivers the code.</p>)}
              <span class="fd-role-card-meta">{locale === "zh" && (<span>直接对话 · 无需转交</span>)}{locale === "en" && (<span>Direct chat · no handoff</span>)}</span>
            </div>

            <div class="fd-role-card" data-role-card="review" data-state="idle">
              <div class="fd-role-card-head">
                <span class="fd-role-card-name">{locale === "zh" && (<span>代码审查员</span>)}{locale === "en" && (<span>Code reviewer</span>)}</span>
                <span class="fd-role-custom">{locale === "zh" && (<span>自定义</span>)}{locale === "en" && (<span>Custom</span>)}</span>
              </div>
              {locale === "zh" && (<p>只读检查改动，只列问题与建议，不修改文件。</p>)}
              {locale === "en" && (<p>Reads the diff, lists issues and suggestions, and never edits files.</p>)}
              <span class="fd-role-card-meta">{locale === "zh" && (<span>只读审查 · 用户自定义</span>)}{locale === "en" && (<span>Read-only · user-defined</span>)}</span>
            </div>
          </div>
        </aside>
      </div>

      <div class="fd-newsession" data-appear="0" data-newsession>
        <section class="fd-newsession-card" aria-label={locale === "zh" ? "新建会话" : "New session"}>
          <div class="fd-newsession-head">
            <span class="fd-newsession-title">{locale === "zh" && (<span>新建会话</span>)}{locale === "en" && (<span>New session</span>)}</span>
            <span class="fd-newsession-note">{locale === "zh" && (<span>选角色后直接对话</span>)}{locale === "en" && (<span>Pick a role, chat directly</span>)}</span>
          </div>
          <p class="fd-newsession-label">{locale === "zh" && (<span>选择角色</span>)}{locale === "en" && (<span>Choose a role</span>)}</p>
          <ul class="fd-role-list">
            <li class="fd-role-option" data-role-option="orch">
              <span class="fd-role-option-icon"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 4 3 5-6 5 6 4-3-2 11H5Z" /></svg></span>
              <span class="fd-role-option-main">
                <span class="fd-role-option-name">Orchestrator</span>
                <span class="fd-role-option-desc">{locale === "zh" && (<span>主 Agent · 拆解与派发</span>)}{locale === "en" && (<span>Main agent · plan &amp; dispatch</span>)}</span>
              </span>
              <svg class="i fd-role-option-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>
            </li>
            <li class="fd-role-option" data-role-option="worker">
              <span class="fd-role-option-icon"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 7-4 5 4 5M16 7l4 5-4 5M14 5l-4 14" /></svg></span>
              <span class="fd-role-option-main">
                <span class="fd-role-option-name">Worker</span>
                <span class="fd-role-option-desc">{locale === "zh" && (<span>开发实现 · 直接交付</span>)}{locale === "en" && (<span>Build · ship the change</span>)}</span>
              </span>
              <svg class="i fd-role-option-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>
            </li>
            <li class="fd-role-option" data-role-option="review">
              <span class="fd-role-option-icon"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4-4" /><path d="m8 11 2 2 4-4" /></svg></span>
              <span class="fd-role-option-main">
                <span class="fd-role-option-name">{locale === "zh" && (<span>代码审查员</span>)}{locale === "en" && (<span>Code reviewer</span>)}</span>
                <span class="fd-role-option-desc"><span class="fd-role-custom">{locale === "zh" && (<span>自定义</span>)}{locale === "en" && (<span>Custom</span>)}</span> · {locale === "zh" && (<span>只读审查</span>)}{locale === "en" && (<span>review only</span>)}</span>
              </span>
              <svg class="i fd-role-option-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>
            </li>
          </ul>
          <div class="fd-newsession-foot">
            <span class="fd-chip"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect width="16" height="16" x="4" y="4" rx="2" /><rect width="6" height="6" x="9" y="9" rx="1" /><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" /></svg>deepseek-v4.1-flash</span>
            <span class="fd-newsession-create">{locale === "zh" && (<span>创建</span>)}{locale === "en" && (<span>Create</span>)}</span>
          </div>
        </section>
      </div>
    </div>
  </div>
  <div class="docs-demo-actions">
    <button class="docs-demo-replay" type="button" data-demo-replay>
      {locale === "zh" && (<span>重播</span>)}{locale === "en" && (<span>Replay</span>)}
    </button>
  </div>
</figure>
