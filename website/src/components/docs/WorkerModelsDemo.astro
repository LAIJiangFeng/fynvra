---
import { type DemoLocale, prompts } from './prompts';

interface Props {
  locale: DemoLocale;
}

const { locale } = Astro.props;
---

<figure
  class="docs-demo not-content"
  data-pagefind-ignore
  data-demo="model"
  aria-label={locale === "zh" ? "界面演示：给不同 Worker 指定不同模型" : "Interface demo: a different model per worker"}
>
  <div class="fd-app" data-demo-app>
    <div class="fd-titlebar">
      <div class="fd-title-left">
        <span class="fd-tb-icon" aria-hidden="true">
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M9 4v16M15 9l-3 3 3 3" /></svg>
        </span>
        <span class="fd-brand">Fynvra</span><span class="fd-slash">/</span><span class="fd-workspace-name">fynvra</span>
      </div>
      <div class="fd-title-right" aria-hidden="true">
        <span class="fd-tb-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21h-4v-.09A1.7 1.7 0 0 0 8.5 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3v-4h.09A1.7 1.7 0 0 0 4.6 8.5a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3h4v.09A1.7 1.7 0 0 0 15.5 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.4 9c.15.38.36.72.6 1 .3.3.68.44 1.1.4H21v4h-.09a1.7 1.7 0 0 0-1.51.6Z" /></svg></span>
        <span class="fd-tb-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" /></svg></span>
        <span class="fd-tb-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M15 4v16M10 9l-3 3 3 3" /></svg></span>
        <span class="fd-window-controls">
          <span class="fd-wc"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg></span>
          <span class="fd-wc"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="5" width="14" height="14" /></svg></span>
          <span class="fd-wc"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></span>
        </span>
      </div>
    </div>
    <div class="fd-scene" id="fd-scene-model" data-scene="model" data-phase="0">
      <div class="fd-body">
        <aside class="fd-side">
          <div class="fd-side-head">
            {locale === "zh" && (<span>工作区</span>)}{locale === "en" && (<span>Workspaces</span>)}
            <span class="fd-side-actions" aria-hidden="true">
              <span class="fd-mini-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
            </span>
          </div>

          <div class="fd-workspace">
            <div class="fd-ws-row">
              <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /></svg>
              <span>fynvra</span><span class="fd-ws-branch">main</span>
            </div>
            <p class="fd-ws-path">D:\project\fynvra</p>

            <div class="fd-sessions-head">
              {locale === "zh" && (<span>会话</span>)}{locale === "en" && (<span>Sessions</span>)}
              <span class="fd-side-actions" aria-hidden="true">
                <span class="fd-mini-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4-4" /></svg></span>
                <span class="fd-mini-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
              </span>
            </div>

            <div class="fd-session is-active is-idle" data-session="model-orchestrator">
              <span class="fd-dot is-run"></span>
              <span class="fd-session-main">
                <span class="fd-session-title">{locale === "zh" && (<span>首页实现与文档整理</span>)}{locale === "en" && (<span>Home implementation &amp; docs</span>)}</span>
                <span class="fd-session-sub">
                  <span class="fd-role is-orch"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 4 3 5-6 5 6 4-3-2 11H5Z" /></svg>Orchestrator</span>
                  <span class="fd-model-tag">claude-sonnet-5-5</span>
                </span>
              </span>
            </div>

            <div class="fd-session is-idle" data-session="model-home" data-appear="3">
              <span class="fd-dot is-run"></span>
              <span class="fd-session-main">
                <span class="fd-session-title">{locale === "zh" && (<span>首页：统一间距与字号</span>)}{locale === "en" && (<span>Home: spacing &amp; type sizes</span>)}</span>
                <span class="fd-session-sub">
                  <span class="fd-role">Worker</span>
                  <span class="fd-model-tag">deepseek-chat</span>
                </span>
              </span>
            </div>

            <div class="fd-session is-idle" data-session="model-docs" data-appear="4">
              <span class="fd-dot is-run"></span>
              <span class="fd-session-main">
                <span class="fd-session-title">{locale === "zh" && (<span>文档：补齐缺失的操作步骤</span>)}{locale === "en" && (<span>Docs: fill in the missing steps</span>)}</span>
                <span class="fd-session-sub">
                  <span class="fd-role">Worker</span>
                  <span class="fd-model-tag">gpt-5.5</span>
                </span>
              </span>
            </div>
          </div>
        </aside>

        <div class="fd-main">
          <div class="fd-editor-tabs" aria-hidden="true">
            <span class="fd-editor-tab is-active">{locale === "zh" && (<span>对话</span>)}{locale === "en" && (<span>Chat</span>)}</span>
            <span class="fd-editor-tab">index.html</span>
            <span class="fd-editor-tab">docs.html</span>
            <span class="fd-editor-add"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
          </div>

          <div class="fd-chat-head is-idle" data-chat-head data-state="idle">
            <span class="fd-dot is-run"></span>
            <span class="fd-chat-title">{locale === "zh" && (<span>首页实现与文档整理</span>)}{locale === "en" && (<span>Home implementation &amp; docs</span>)}</span>
            <span class="fd-role is-orch"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 4 3 5-6 5 6 4-3-2 11H5Z" /></svg>Orchestrator</span>
            <span class="fd-chip"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4v10a3 3 0 0 0 3 3h9M15 14l3 3-3 3M6 4v4" /></svg>main</span>
            <span class="fd-chip fd-chat-model"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect width="16" height="16" x="4" y="4" rx="2" /><rect width="6" height="6" x="9" y="9" rx="1" /><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" /></svg>claude-sonnet-5-5</span>
            <span class="fd-chat-status">
              <span class="fd-st-run">{locale === "zh" && (<span>运行中</span>)}{locale === "en" && (<span>Running</span>)}</span>
              <span class="fd-st-idle">{locale === "zh" && (<span>空闲</span>)}{locale === "en" && (<span>Idle</span>)}</span>
            </span>
          </div>

          <div class="fd-timeline" data-timeline>
            <div class="fd-stream">
              <div class="fd-empty" data-empty hidden>
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 0 1-8 8H5l-2 2V12a8 8 0 0 1 8-8h2a8 8 0 0 1 8 8Z" /><path d="M8 11h8M8 15h5" /></svg>
                {locale === "zh" && (<span>在输入框写清两个任务，并点名每个 Worker 使用的模型。</span>)}
                {locale === "en" && (<span>Describe both tasks and name the model for each worker in the request.</span>)}
              </div>

              <div class="fd-msg is-user" data-appear="2">
                <span data-demo-user="model" data-demo-lang={locale}>{prompts["model"][locale]}</span>

              </div>

              <div class="fd-msg fd-agent" data-appear="2">
                {locale === "zh" && (<p>收到。首页实现交给 deepseek-chat 的 Worker，文档整理交给 gpt-5.5 的 Worker。两个模型都已配置好，两个任务又互不依赖，我会并行派发；都完成后由我审查合并。</p>)}
                {locale === "en" && (<p>On it. Home page implementation goes to a deepseek-chat worker, docs cleanup to a gpt-5.5 worker. Both models are configured, and the tasks are independent, so I'll dispatch them in parallel and review and merge both when they finish.</p>)}
              </div>

              <div class="fd-tool" data-appear="3">
                <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg>
                <span class="fd-tool-label">{locale === "zh" && (<span>派发任务</span>)}{locale === "en" && (<span>Dispatch task</span>)}</span>
                <span class="fd-tool-title">{locale === "zh" && (<span>首页：统一间距与字号</span>)}{locale === "en" && (<span>Home: spacing &amp; type sizes</span>)}</span>
                <span class="fd-role">Worker</span>
                <span class="fd-model-tag">deepseek-chat</span>
                <code class="fd-tool-branch">fynvra/home-impl</code>
                <span class="fd-tool-meta"><span>0.3s</span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === "zh" ? "已完成" : "Completed"}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg><svg class="i is-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span>
              </div>

              <div class="fd-tool" data-appear="4">
                <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg>
                <span class="fd-tool-label">{locale === "zh" && (<span>派发任务</span>)}{locale === "en" && (<span>Dispatch task</span>)}</span>
                <span class="fd-tool-title">{locale === "zh" && (<span>文档：补齐缺失的操作步骤</span>)}{locale === "en" && (<span>Docs: fill in the missing steps</span>)}</span>
                <span class="fd-role">Worker</span>
                <span class="fd-model-tag">gpt-5.5</span>
                <code class="fd-tool-branch">fynvra/docs-cleanup</code>
                <span class="fd-tool-meta"><span>0.3s</span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === "zh" ? "已完成" : "Completed"}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg><svg class="i is-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span>
              </div>

              <div class="fd-msg fd-agent" data-appear="4">
                {locale === "zh" && (<p>两个 Worker 已经在并行的 worktree 里开工：deepseek-chat 改首页实现，gpt-5.5 整理文档。</p>)}
                {locale === "en" && (<p>Both workers are running in parallel worktrees: deepseek-chat on the home page implementation, gpt-5.5 on the docs cleanup.</p>)}
              </div>

              <div class="fd-tool" data-appear="5">
                <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h10M4 19h7" /><path d="m17 15 3 3-3 3M20 18h-7" /></svg>
                <span class="fd-tool-label">{locale === "zh" && (<span>Worker 回报</span>)}{locale === "en" && (<span>Worker report</span>)}</span>
                <span class="fd-tool-title">{locale === "zh" && (<span>首页 · 3 个文件</span>)}{locale === "en" && (<span>Home · 3 files</span>)}</span>
                <span class="fd-role">Worker</span>
                <span class="fd-model-tag">deepseek-chat</span>
                <code>+74 −58</code>
                <span class="fd-tool-meta"><span>4.6s</span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === "zh" ? "已完成" : "Completed"}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg><svg class="i is-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span>
              </div>

              <div class="fd-tool" data-appear="5">
                <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h10M4 19h7" /><path d="m17 15 3 3-3 3M20 18h-7" /></svg>
                <span class="fd-tool-label">{locale === "zh" && (<span>Worker 回报</span>)}{locale === "en" && (<span>Worker report</span>)}</span>
                <span class="fd-tool-title">{locale === "zh" && (<span>文档 · 3 个文件</span>)}{locale === "en" && (<span>Docs · 3 files</span>)}</span>
                <span class="fd-role">Worker</span>
                <span class="fd-model-tag">gpt-5.5</span>
                <code>+96 −31</code>
                <span class="fd-tool-meta"><span>4.9s</span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === "zh" ? "已完成" : "Completed"}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg><svg class="i is-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span>
              </div>

              <div class="fd-msg fd-agent" data-appear="5">
                {locale === "zh" && (<p>两个 Worker 都回报完成。首页实现已提交，文档整理也补齐了缺失的操作步骤；现在按同一份需求开始审查。</p>)}
                {locale === "en" && (<p>Both workers reported back. The home page implementation is committed and the docs cleanup filled in the missing steps; I'll review both against the same request now.</p>)}
              </div>

              <div class="fd-tool" data-appear="6">
                <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h10M4 19h7" /><path d="m17 15 3 3-3 3M20 18h-7" /></svg>
                <span class="fd-tool-label">{locale === "zh" && (<span>审查改动</span>)}{locale === "en" && (<span>Review diff</span>)}</span>
                <span class="fd-tool-title">{locale === "zh" && (<span>首页 · 3 个文件</span>)}{locale === "en" && (<span>Home · 3 files</span>)}</span>
                <code>+74 −58</code>
                <span class="fd-tool-meta"><span>1.2s</span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === "zh" ? "已完成" : "Completed"}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg><svg class="i is-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span>
              </div>

              <div class="fd-tool" data-appear="6">
                <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h10M4 19h7" /><path d="m17 15 3 3-3 3M20 18h-7" /></svg>
                <span class="fd-tool-label">{locale === "zh" && (<span>审查改动</span>)}{locale === "en" && (<span>Review diff</span>)}</span>
                <span class="fd-tool-title">{locale === "zh" && (<span>文档 · 3 个文件</span>)}{locale === "en" && (<span>Docs · 3 files</span>)}</span>
                <code>+96 −31</code>
                <span class="fd-tool-meta"><span>1.4s</span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === "zh" ? "已完成" : "Completed"}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg><svg class="i is-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span>
              </div>

              <div class="fd-tool" data-appear="7">
                <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="5" r="2" /><circle cx="18" cy="5" r="2" /><circle cx="12" cy="19" r="2" /><path d="M6 7v3a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7M12 12v5" /></svg>
                <span class="fd-tool-label">{locale === "zh" && (<span>合并分支</span>)}{locale === "en" && (<span>Merge branch</span>)}</span>
                <span class="fd-tool-title"><code>fynvra/home-impl → main</code></span>
                <span class="fd-tool-meta"><span class="fd-ok">{locale === "zh" && (<span>已合并</span>)}{locale === "en" && (<span>Merged</span>)}</span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === "zh" ? "已完成" : "Completed"}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg></span>
              </div>

              <div class="fd-tool" data-appear="7">
                <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="5" r="2" /><circle cx="18" cy="5" r="2" /><circle cx="12" cy="19" r="2" /><path d="M6 7v3a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7M12 12v5" /></svg>
                <span class="fd-tool-label">{locale === "zh" && (<span>合并分支</span>)}{locale === "en" && (<span>Merge branch</span>)}</span>
                <span class="fd-tool-title"><code>fynvra/docs-cleanup → main</code></span>
                <span class="fd-tool-meta"><span class="fd-ok">{locale === "zh" && (<span>已合并</span>)}{locale === "en" && (<span>Merged</span>)}</span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === "zh" ? "已完成" : "Completed"}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg></span>
              </div>

              <div class="fd-msg fd-agent" data-appear="7">
                {locale === "zh" && (<p>两个任务都通过审查并合并。<code>main</code> 上有两条 <code>--no-ff</code> 提交：首页实现来自 <code>deepseek-chat</code>，文档整理来自 <code>gpt-5.5</code>。</p>)}
                {locale === "en" && (<p>Both tasks passed review and merged. <code>main</code> has two <code>--no-ff</code> commits: the home page implementation from <code>deepseek-chat</code> and the docs cleanup from <code>gpt-5.5</code>.</p>)}
              </div>
            </div>
          </div>

          <div class="fd-composer">
            <div class="fd-composer-box">
              <div class="fd-composer-input"><span data-typed></span><span class="fd-caret" aria-hidden="true"></span><span class="fd-placeholder">{locale === "zh" && (<span>输入消息，Enter 发送</span>)}{locale === "en" && (<span>Message Fynvra…</span>)}</span></div>
              <div class="fd-composer-bar">
                <span class="fd-composer-tools">
                  <span class="fd-mini-btn" aria-hidden="true"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 5h6M19 2v6" /><path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7.5" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /><circle cx="9" cy="9" r="2" /></svg></span>
                  <span class="fd-chip fd-chip-model"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect width="16" height="16" x="4" y="4" rx="2" /><rect width="6" height="6" x="9" y="9" rx="1" /><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" /></svg><span class="fd-chip-label">claude-sonnet-5-5 · high</span></span>
                  <span class="fd-chip fd-chip-approval"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" /><path d="m8 12 3 3 5-5" /></svg>{locale === "zh" && (<span>完全放行</span>)}{locale === "en" && (<span>Full access</span>)}</span>
                </span>
                <span class="fd-send" data-send><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.714 3.048a.498.498 0 0 0-.683.627l2.843 7.627a2 2 0 0 1 0 1.396l-2.842 7.627a.498.498 0 0 0 .682.627l18-8.5a.5.5 0 0 0 0-.904z" /><path d="M6 12h16" /></svg>{locale === "zh" && (<span>发送</span>)}{locale === "en" && (<span>Send</span>)}</span>
              </div>
            </div>
          </div>

          <div class="fd-statusbar" aria-hidden="true">
            <span>tokens ↑11.2k ↓3.1k</span><span>$0.04</span>
            <span class="fd-status-right">
              <span class="is-amber"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" /></svg>{locale === "zh" && (<span>完全放行</span>)}{locale === "en" && (<span>Full</span>)}</span>
              <span><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4v10a3 3 0 0 0 3 3h9M15 14l3 3-3 3M6 4v4" /></svg>main</span>
              <span>claude-sonnet-5-5</span>
            </span>
          </div>
        </div>

        <aside class="fd-panel">
          <div class="fd-panel-head">
            <div class="fd-panel-tabs">
              <span class="fd-panel-tab" data-panel-tab="files">
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /></svg>
                {locale === "zh" && (<span>文件</span>)}{locale === "en" && (<span>Files</span>)}
              </span>
              <span class="fd-panel-tab is-active" data-panel-tab="tasks">
