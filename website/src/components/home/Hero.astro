---
import type { Locale } from '../../content/home/copy';
import ProductDemo from './ProductDemo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="hero">
  <div class="container">
    <div class="hero-intro">
      <h1 class="hero-title rise" style="--i: 1">
        {locale === 'zh' ? (<span data-l="zh"
          ><span class="hero-title-line">只和一个 Agent 对话，</span
          ><span class="hero-title-line"
            >一支团队并行<span class="rotator" aria-hidden="true"
              ><span>修 Bug。</span><span>写测试。</span><span>做重构。</span><span>补文档。</span></span
            ><span class="sr-only">修 Bug、写测试、做重构、补文档。</span></span
          ></span
        >) : (<span data-l="en"
          ><span class="hero-title-line">Talk to one agent.</span
          ><span class="hero-title-line"
            >A team <span class="rotator" aria-hidden="true"
              ><span>fixes bugs.</span><span>writes tests.</span><span>refactors.</span><span>ships docs.</span></span
            ><span class="sr-only">fixes bugs, writes tests, refactors, and ships docs.</span></span
          ></span
        >)}
      </h1>
      <div class="hero-copy rise" style="--i: 2">
        <p class="hero-lead" data-l={locale}>{locale === 'zh' ? "Fynvra 是多 Agent AI 编程工作台，支持任务并行协作、指定 Worker 模型与改动审查合并。" : "Fynvra is a multi-agent AI coding workbench: parallel tasks, per-task worker models, reviewed merges."}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="https://github.com/LAIJiangFeng/fynvra/releases">
            <svg class="i i-download" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" /></svg>
            <span data-l={locale}>{locale === 'zh' ? "下载 Fynvra" : "Download Fynvra"}</span>
          </a>
          <a class="btn btn-ghost" href={`/${locale}/docs/overview/`}>
            <svg class="i" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3.5 5.5A2.5 2.5 0 0 1 6 3h5v16H6a2.5 2.5 0 0 0-2.5 2Z" />
              <path d="M20.5 5.5A2.5 2.5 0 0 0 18 3h-5v16h5a2.5 2.5 0 0 1 2.5 2Z" />
            </svg>
            <span data-l={locale}>{locale === 'zh' ? "阅读使用文档" : "Read the docs"}</span>
          </a>
        </div>
        <p class="hero-meta">
          <span>Windows x64 · macOS Intel / Apple Silicon</span>
          <span aria-hidden="true">/</span>
          <span>Apache-2.0</span>
          <span aria-hidden="true">/</span>
          <a href="#start"><span data-l={locale}>{locale === 'zh' ? "从源码运行" : "Run from source"}</span></a>
        </p>
      </div>
    </div>

    <ProductDemo locale={locale} />
  </div>
</section>
