---
import type { Locale } from '../../content/home/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="fd-scene" id="fd-scene-queue" data-scene="queue" data-phase="0" hidden>
  <div class="fd-body">
    <aside class="fd-side">
      <div class="fd-side-head">
        <span data-l={locale}>{locale === 'zh' ? "工作区" : "Workspaces"}</span>
        <span class="fd-side-actions" aria-hidden="true">
          <span class="fd-mini-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
        </span>
      </div>

      <div class="fd-workspace">
        <div class="fd-ws-row">
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /></svg>
          <span>fynvra</span><span class="fd-ws-branch">main</span>
        </div>
        <p class="fd-ws-path">D:\project\fynvra</p>

        <div class="fd-sessions-head">
          <span data-l={locale}>{locale === 'zh' ? "会话" : "Sessions"}</span>
          <span class="fd-side-actions" aria-hidden="true">
            <span class="fd-mini-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4-4" /></svg></span>
            <span class="fd-mini-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
          </span>
        </div>

        <div class="fd-session is-active" data-session="queue-current">
          <span class="fd-dot is-run"></span>
          <span class="fd-session-main">
            <span class="fd-session-title"><span data-l={locale}>{locale === 'zh' ? "首页：三场景演示" : "Homepage: three demo scenes"}</span></span>
            <span class="fd-session-sub">
              <span class="fd-role is-orch"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 4 3 5-6 5 6 4-3-2 11H5Z" /></svg>Orchestrator</span>
              <span class="fd-model-tag">DeepSeek V4.1</span>
            </span>
          </span>
        </div>
      </div>
    </aside>

    <div class="fd-main">
      <div class="fd-editor-tabs" aria-hidden="true">
        <span class="fd-editor-tab is-active"><span data-l={locale}>{locale === 'zh' ? "对话" : "Chat"}</span></span>
        <span class="fd-editor-tab">index.html</span>
        <span class="fd-editor-tab">home.css</span>
        <span class="fd-editor-add"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
      </div>

      <div class="fd-chat-head" data-chat-head data-state="run">
        <span class="fd-dot is-run"></span>
        <span class="fd-chat-title"><span data-l={locale}>{locale === 'zh' ? "首页：三场景演示" : "Homepage: three demo scenes"}</span></span>
        <span class="fd-role is-orch"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 4 3 5-6 5 6 4-3-2 11H5Z" /></svg>Orchestrator</span>
        <span class="fd-chip"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4v10a3 3 0 0 0 3 3h9M15 14l3 3-3 3M6 4v4" /></svg>main</span>
        <span class="fd-chat-status">
          <span class="fd-st-run"><span data-l={locale}>{locale === 'zh' ? "运行中" : "Running"}</span></span>
          <span class="fd-st-idle"><span data-l={locale}>{locale === 'zh' ? "空闲" : "Idle"}</span></span>
        </span>
      </div>

      <div class="fd-timeline" data-timeline>
        <div class="fd-stream">
          <div class="fd-msg is-user" data-appear="0">
            <span data-l={locale}>{locale === 'zh' ? "把顶部演示改成三个场景轮播，先做桌面布局。" : "Turn the hero demo into three rotating scenes, desktop layout first."}</span>
          </div>

          <div class="fd-msg fd-agent" data-appear="0">
            <p data-l={locale}>{locale === 'zh' ? "收到，当前回合正在改演示区。后续需求可以直接提交，会先排队，等我处理完这条再依次接上。" : "On it — this turn is rebuilding the demo. You can submit more requests now; they queue and start in order after this turn."}</p>
          </div>

          <div class="fd-tool fd-queue-current" data-appear="0" data-queue-current>
            <span class="fd-dot is-run"></span>
            <span class="fd-tool-label"><span data-l={locale}>{locale === 'zh' ? "当前回合" : "Current turn"}</span></span>
            <span class="fd-tool-title"><span data-l={locale}>{locale === 'zh' ? "重构顶部演示切换" : "Rebuild the demo scenes"}</span></span>
            <span class="fd-tool-meta fd-queue-current-state">
              <span class="fd-queue-run"><span data-l={locale}>{locale === 'zh' ? "处理中" : "Running"}</span></span>
              <span class="fd-queue-done"><span data-l={locale}>{locale === 'zh' ? "已完成" : "Done"}</span></span>
            </span>
          </div>

          <div class="fd-msg is-user" data-appear="4">
            <span data-l={locale}>{locale === 'zh' ? "补上移动端适配。" : "Add the mobile layout."}</span>
          </div>

          <div class="fd-msg fd-agent" data-appear="4">
            <p data-l={locale}>{locale === 'zh' ? "队列 1 / 2 完成：移动端布局已补上。" : "Queued item 1 of 2 done: the mobile layout is in."}</p>
          </div>

          <div class="fd-msg is-user" data-appear="5">
            <span data-l={locale}>{locale === 'zh' ? "再补一份使用说明。" : "Then add a short usage guide."}</span>
          </div>

          <div class="fd-msg fd-agent" data-appear="5">
            <p data-l={locale}>{locale === 'zh' ? "队列 2 / 2 完成：使用说明已补上。排队消息已全部处理完。" : "Queued item 2 of 2 done: the usage guide is in. The queue is clear."}</p>
          </div>
        </div>
      </div>

      <div class="fd-composer">
        <div class="fd-queue" data-queue hidden>
          <div class="fd-queue-head">
            <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 11h8M4 17h8" /><path d="M17 12v6M14 15l3 3 3-3" /></svg>
            <span data-l={locale}>{locale === 'zh' ? "排队消息" : "Queued messages"}</span>
            <span class="fd-queue-count" data-queue-count>0</span>
          </div>
          <ul class="fd-queue-list">
            <li class="fd-queue-item" data-queue-item="1" hidden>
              <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              <span class="fd-queue-text"><span data-l={locale}>{locale === 'zh' ? "补上移动端适配。" : "Add the mobile layout."}</span></span>
              <span class="fd-queue-state"><span data-l={locale}>{locale === 'zh' ? "排队中" : "Queued"}</span></span>
            </li>
            <li class="fd-queue-item" data-queue-item="2" hidden>
              <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              <span class="fd-queue-text"><span data-l={locale}>{locale === 'zh' ? "再补一份使用说明。" : "Then add a short usage guide."}</span></span>
              <span class="fd-queue-state"><span data-l={locale}>{locale === 'zh' ? "排队中" : "Queued"}</span></span>
            </li>
          </ul>
        </div>

        <div class="fd-composer-box">
          <div class="fd-composer-input" data-mode="queue"><span data-typed></span><span class="fd-caret" aria-hidden="true"></span><span class="fd-placeholder"><span class="fd-placeholder-queue"><span data-l={locale}>{locale === 'zh' ? "继续输入，提交后排队" : "Keep typing — new messages will queue"}</span></span><span class="fd-placeholder-idle"><span data-l={locale}>{locale === 'zh' ? "输入消息，Enter 发送" : "Message Fynvra…"}</span></span></span></div>
          <div class="fd-composer-bar">
            <span class="fd-composer-tools">
              <span class="fd-mini-btn" aria-hidden="true"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 5h6M19 2v6" /><path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7.5" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /><circle cx="9" cy="9" r="2" /></svg></span>
              <span class="fd-chip fd-chip-model"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect width="16" height="16" x="4" y="4" rx="2" /><rect width="6" height="6" x="9" y="9" rx="1" /><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" /></svg><span class="fd-chip-label">deepseek-v4.1-flash · high</span></span>
              <span class="fd-chip fd-chip-approval"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" /><path d="m8 12 3 3 5-5" /></svg><span data-l={locale}>{locale === 'zh' ? "完全放行" : "Full access"}</span></span>
            </span>
            <span class="fd-send" data-send data-mode="queue"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.714 3.048a.498.498 0 0 0-.683.627l2.843 7.627a2 2 0 0 1 0 1.396l-2.842 7.627a.498.498 0 0 0 .682.627l18-8.5a.5.5 0 0 0 0-.904z" /><path d="M6 12h16" /></svg><span class="fd-send-queue"><span data-l={locale}>{locale === 'zh' ? "排队" : "Queue"}</span></span><span class="fd-send-idle"><span data-l={locale}>{locale === 'zh' ? "发送" : "Send"}</span></span></span>
          </div>
        </div>
      </div>

      <div class="fd-statusbar" aria-hidden="true">
        <span>tokens ↑11.2k ↓2.8k</span><span>$0.04</span>
        <span class="fd-status-right">
          <span class="is-amber"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" /></svg><span data-l={locale}>{locale === 'zh' ? "完全放行" : "Full"}</span></span>
          <span><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4v10a3 3 0 0 0 3 3h9M15 14l3 3-3 3M6 4v4" /></svg>main</span>
          <span>deepseek-v4.1-flash</span>
        </span>
      </div>
    </div>

    <aside class="fd-panel">
      <div class="fd-panel-head">
        <div class="fd-panel-tabs">
          <span class="fd-panel-tab is-active">
            <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4 6l1 1 2-2M4 12l1 1 2-2M4 18l1 1 2-2" /></svg>
            <span data-l={locale}>{locale === 'zh' ? "任务" : "Tasks"}</span>
          </span>
        </div>
        <span class="fd-panel-refresh" aria-hidden="true"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2 5.3M20 4v7h-7" /></svg></span>
      </div>

      <div class="fd-panel-body">
        <div class="fd-task" data-queue-task data-state="run">
          <div class="fd-task-head">
            <span class="fd-task-title"><span data-l={locale}>{locale === 'zh' ? "首页：三场景演示" : "Homepage: three demo scenes"}</span></span>
            <span class="fd-role is-orch"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 4 3 5-6 5 6 4-3-2 11H5Z" /></svg>Orchestrator</span>
          </div>
          <div class="fd-task-meta">
            <svg class="i" viewBox="0 0 24 24" style="width: 10px; height: 10px" aria-hidden="true"><path d="M6 4v10a3 3 0 0 0 3 3h9M15 14l3 3-3 3M6 4v4" /></svg>
            <code>fynvra/home-demo</code>
            <span class="fd-status st-todo"><span data-l={locale}>{locale === 'zh' ? "待开始" : "To do"}</span></span>
            <span class="fd-status st-run"><span data-l={locale}>{locale === 'zh' ? "进行中" : "Running"}</span></span>
            <span class="fd-status st-review"><span data-l={locale}>{locale === 'zh' ? "待验收" : "In review"}</span></span>
            <span class="fd-status st-done"><span data-l={locale}>{locale === 'zh' ? "已完成" : "Completed"}</span></span>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>
