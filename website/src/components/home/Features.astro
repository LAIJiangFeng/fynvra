---
import type { Locale } from '../../content/home/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="section" id="features">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow"><b>01</b><span data-l={locale}>{locale === 'zh' ? "能力" : "Capabilities"}</span></p>
      <h2 class="section-title">
        <span data-l={locale}>{locale === 'zh' ? "一个工作台，装下多 Agent 开发。" : "One workbench for multi-agent development."}</span
        >
      </h2>
    </header>

    <div class="cap-grid">
      <article class="cap-card reveal">
        <span class="cap-icon"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg></span>
        <h3><span data-l={locale}>{locale === 'zh' ? "角色随项目定制" : "Roles shaped to your project"}</span></h3>
        <p data-l={locale}>{locale === 'zh' ? "自定义角色的提示词、模型、工具、技能和 MCP。" : "Customize each role’s prompt, model, tools, skills, and MCP."}</p>
      </article>

      <article class="cap-card reveal">
        <span class="cap-icon"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3" /><path d="M9 9h6v6H9zM9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2" /></svg></span>
        <h3><span data-l={locale}>{locale === 'zh' ? "模型自己选，配置可导入" : "Your models, imported"}</span></h3>
        <p data-l={locale}>{locale === 'zh' ? "挑好模型就能开工，其他工具里配好的模型和 MCP 也可以直接导入。" : "Pick your model and go; import the providers and MCP servers you already set up elsewhere."}</p>
      </article>

      <article class="cap-card reveal">
        <span class="cap-icon"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="5" r="2" /><circle cx="18" cy="5" r="2" /><circle cx="12" cy="19" r="2" /><path d="M6 7v3a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7M12 12v5" /></svg></span>
        <h3><span data-l={locale}>{locale === 'zh' ? "每个任务，一个 worktree" : "One worktree per task"}</span></h3>
        <p data-l={locale}>{locale === 'zh' ? "每个任务在自己的分支和目录里改，互不踩踏，主仓库在验收通过前保持原样。" : "Each task works in its own branch and folder, so nothing collides and your main checkout stays untouched until review passes."}</p>
      </article>

      <article class="cap-card reveal">
        <span class="cap-icon"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 0 1-8 8H5l-2 2V12a8 8 0 0 1 8-8h2a8 8 0 0 1 8 8Z" /><path d="M8 11h8M8 15h5" /></svg></span>
        <h3><span data-l={locale}>{locale === 'zh' ? "派发之后，不必干等" : "Dispatch, then keep moving"}</span></h3>
        <p data-l={locale}>{locale === 'zh' ? "派发后可以接着讨论下一件事，Worker 的提问和汇报会自动回到收件箱。" : "Keep talking after dispatch; worker questions and reports come back to the inbox."}</p>
      </article>

      <article class="cap-card reveal">
        <span class="cap-icon"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="m7 9 3 3-3 3M13 15h4" /></svg></span>
        <h3><span data-l={locale}>{locale === 'zh' ? "文件、终端、改动，不用切窗口" : "Files, terminals, and diffs in one place"}</span></h3>
        <p data-l={locale}>{locale === 'zh' ? "文件、终端和逐文件改动都并排在对话旁边，随时可查。" : "Files, terminals, and per-file diffs sit beside the chat, always within reach."}</p>
      </article>

      <article class="cap-card reveal">
        <span class="cap-icon"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></svg></span>
        <h3><span data-l={locale}>{locale === 'zh' ? "花了多少，交付多少" : "What it cost, what it shipped"}</span></h3>
        <p data-l={locale}>{locale === 'zh' ? "Token、费用、缓存命中率和一次验收通过率，都从本机记录里统计。" : "Tokens, cost, cache hit rate, and first-pass acceptance, counted from local records."}</p>
      </article>
    </div>
  </div>
</section>
