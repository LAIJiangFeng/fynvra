---
import type { Locale } from '../../content/home/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="fd-scene" id="fd-scene-model" data-scene="model" data-phase="0" hidden>
  <div class="fd-body">
    <aside class="fd-side">
      <div class="fd-side-head">
        <span data-l={locale}>{locale === 'zh' ? "工作区" : "Workspaces"}</span>
        <span class="fd-side-actions" aria-hidden="true">
          <span class="fd-mini-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
        </span>
      </div>

      <div class="fd-workspace">
        <div class="fd-ws-row">
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /></svg>
          <span>fynvra</span><span class="fd-ws-branch">main</span>
        </div>
        <p class="fd-ws-path">D:\project\fynvra</p>

        <div class="fd-sessions-head">
          <span data-l={locale}>{locale === 'zh' ? "会话" : "Sessions"}</span>
          <span class="fd-side-actions" aria-hidden="true">
            <span class="fd-mini-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4-4" /></svg></span>
            <span class="fd-mini-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
          </span>
        </div>

        <div class="fd-session is-active" data-session="model-orchestrator">
          <span class="fd-dot is-run"></span>
          <span class="fd-session-main">
            <span class="fd-session-title"><span data-l={locale}>{locale === 'zh' ? "侧栏交互优化" : "Sidebar polish"}</span></span>
            <span class="fd-session-sub">
              <span class="fd-role is-orch"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 4 3 5-6 5 6 4-3-2 11H5Z" /></svg>Orchestrator</span>
              <span class="fd-model-tag">GPT-5.2</span>
            </span>
          </span>
        </div>

        <div class="fd-session is-idle" data-session="model-impl" data-appear="3">
          <span class="fd-dot is-run"></span>
          <span class="fd-session-main">
            <span class="fd-session-title"><span data-l={locale}>{locale === 'zh' ? "实现侧栏折叠" : "Collapse sidebar"}</span></span>
            <span class="fd-session-sub">
              <span class="fd-role">Worker</span>
              <span class="fd-model-tag">DeepSeek</span>
            </span>
          </span>
        </div>

        <div class="fd-session is-idle" data-session="model-review" data-appear="4">
          <span class="fd-dot is-run"></span>
          <span class="fd-session-main">
            <span class="fd-session-title"><span data-l={locale}>{locale === 'zh' ? "审查侧栏改动" : "Review sidebar diff"}</span></span>
            <span class="fd-session-sub">
              <span class="fd-role">Worker</span>
              <span class="fd-model-tag">GPT-5.2</span>
            </span>
          </span>
        </div>
      </div>
    </aside>

    <div class="fd-main">
      <div class="fd-editor-tabs" aria-hidden="true">
        <span class="fd-editor-tab is-active"><span data-l={locale}>{locale === 'zh' ? "对话" : "Chat"}</span></span>
        <span class="fd-editor-tab">Sidebar.tsx</span>
        <span class="fd-editor-tab">sidebar.css</span>
        <span class="fd-editor-add"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
      </div>

      <div class="fd-chat-head is-idle" data-chat-head data-state="idle">
        <span class="fd-dot is-run"></span>
        <span class="fd-chat-title"><span data-l={locale}>{locale === 'zh' ? "侧栏交互优化" : "Sidebar polish"}</span></span>
        <span class="fd-role is-orch"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 4 3 5-6 5 6 4-3-2 11H5Z" /></svg>Orchestrator</span>
        <span class="fd-chip"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4v10a3 3 0 0 0 3 3h9M15 14l3 3-3 3M6 4v4" /></svg>main</span>
        <span class="fd-chip fd-chat-model"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect width="16" height="16" x="4" y="4" rx="2" /><rect width="6" height="6" x="9" y="9" rx="1" /><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" /></svg>GPT-5.2</span>
        <span class="fd-chat-status">
          <span class="fd-st-run"><span data-l={locale}>{locale === 'zh' ? "运行中" : "Running"}</span></span>
          <span class="fd-st-idle"><span data-l={locale}>{locale === 'zh' ? "空闲" : "Idle"}</span></span>
        </span>
      </div>

      <div class="fd-timeline" data-timeline>
        <div class="fd-stream">
          <div class="fd-empty" data-empty hidden>
            <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 0 1-8 8H5l-2 2V12a8 8 0 0 1 8-8h2a8 8 0 0 1 8 8Z" /><path d="M8 11h8M8 15h5" /></svg>
            <span data-l={locale}>{locale === 'zh' ? "在输入框写清任务，并用文字为每个 Worker 指定模型。" : "Describe the tasks and name a model for each worker in the request."}</span>
          </div>

          <div class="fd-msg is-user" data-appear="2">
            <span data-l={locale}>{locale === 'zh' ? "让实现侧栏折叠的 Worker 用 DeepSeek，审查改动的 Worker 用 GPT。" : "Use DeepSeek for the worker implementing sidebar collapse, and GPT for the worker reviewing the diff."}</span>
          </div>

          <div class="fd-msg fd-agent" data-appear="2">
            <p data-l={locale}>{locale === 'zh' ? "收到。实现任务派给 DeepSeek 的 Worker，审查任务派给 GPT 的 Worker；审查会等实现回报、拿到 diff 后再开始。" : "On it. The implementation goes to a DeepSeek worker, the review to a GPT worker. The review starts once the implementation reports back with a diff."}</p>
          </div>

          <div class="fd-tool" data-appear="3">
            <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg>
            <span class="fd-tool-label"><span data-l={locale}>{locale === 'zh' ? "派发任务" : "Dispatch task"}</span></span>
            <span class="fd-tool-title"><span data-l={locale}>{locale === 'zh' ? "实现侧栏折叠" : "Implement sidebar collapse"}</span></span>
            <span class="fd-role">Worker</span>
            <span class="fd-model-tag">DeepSeek V4.1</span>
            <code class="fd-tool-branch">fynvra/sidebar-collapse</code>
            <span class="fd-tool-meta"><span>0.3s</span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === 'zh' ? '已完成' : 'Completed'}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg><svg class="i is-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span>
          </div>

          <div class="fd-tool" data-appear="4">
            <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg>
            <span class="fd-tool-label"><span data-l={locale}>{locale === 'zh' ? "排队任务" : "Queue task"}</span></span>
            <span class="fd-tool-title"><span data-l={locale}>{locale === 'zh' ? "审查侧栏改动" : "Review sidebar diff"}</span></span>
            <span class="fd-role">Worker</span>
            <span class="fd-model-tag">GPT-5.2</span>
            <code class="fd-tool-branch">fynvra/sidebar-review</code>
            <span class="fd-tool-meta"><span data-l={locale}>{locale === 'zh' ? "依赖实现" : "After diff"}</span><svg class="i is-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span>
          </div>

          <div class="fd-msg fd-agent" data-appear="4">
            {locale === 'zh' ? (<p data-l="zh">DeepSeek 正在改 <code>Sidebar.tsx</code>；GPT 的审查任务已排队，等实现回报并产出 diff 后开始，不会空跑。</p>) : (<p data-l="en">DeepSeek is editing <code>Sidebar.tsx</code>. The GPT review is queued and starts only after the implementation reports a diff, so it isn't running empty.</p>)}
          </div>

          <div class="fd-tool" data-appear="5">
            <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h10M4 19h7" /><path d="m17 15 3 3-3 3M20 18h-7" /></svg>
            <span class="fd-tool-label"><span data-l={locale}>{locale === 'zh' ? "Worker 回报" : "Worker report"}</span></span>
            <span class="fd-tool-title"><span data-l={locale}>{locale === 'zh' ? "侧栏折叠 · 3 个文件" : "Sidebar collapse · 3 files"}</span></span>
            <span class="fd-role">Worker</span>
            <span class="fd-model-tag">DeepSeek V4.1</span>
            <code>+62 −18</code>
            <span class="fd-tool-meta"><span>4.8s</span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === 'zh' ? '已完成' : 'Completed'}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg><svg class="i is-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span>
          </div>

          <div class="fd-msg fd-agent" data-appear="5">
            {locale === 'zh' ? (<p data-l="zh">实现已回报：<code>Sidebar.tsx</code>、<code>sidebar.css</code> 和快照检查通过。diff 已交给 GPT，审查开始。</p>) : (<p data-l="en">Implementation reported back: <code>Sidebar.tsx</code>, <code>sidebar.css</code>, and the snapshot check passed. The diff is with GPT and the review has started.</p>)}
          </div>

          <div class="fd-tool" data-appear="6">
            <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2" /><path d="m8 12 2.5 2.5L16 9" /></svg>
            <span class="fd-tool-label"><span data-l={locale}>{locale === 'zh' ? "审查通过" : "Review passed"}</span></span>
            <span class="fd-tool-title"><span data-l={locale}>{locale === 'zh' ? "侧栏折叠 · 0 个阻塞" : "Sidebar collapse · 0 blockers"}</span></span>
            <span class="fd-role">Worker</span>
            <span class="fd-model-tag">GPT-5.2</span>
            <code>0 blockers</code>
            <span class="fd-tool-meta"><span>2.1s</span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === 'zh' ? '已完成' : 'Completed'}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg><svg class="i is-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span>
          </div>

          <div class="fd-msg fd-agent" data-appear="6">
            <p data-l={locale}>{locale === 'zh' ? "GPT 审查回报：0 个阻塞，diff 可以合并。" : "GPT reported back: 0 blockers, the diff is ready to merge."}</p>
          </div>

          <div class="fd-tool" data-appear="7">
            <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="5" r="2" /><circle cx="18" cy="5" r="2" /><circle cx="12" cy="19" r="2" /><path d="M6 7v3a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7M12 12v5" /></svg>
            <span class="fd-tool-label"><span data-l={locale}>{locale === 'zh' ? "合并分支" : "Merge branch"}</span></span>
            <span class="fd-tool-title"><code>fynvra/sidebar-collapse → main</code></span>
            <span class="fd-tool-meta"><span class="fd-ok"><span data-l={locale}>{locale === 'zh' ? "已合并" : "Merged"}</span></span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === 'zh' ? '已完成' : 'Completed'}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg></span>
          </div>

          <div class="fd-msg fd-agent" data-appear="7">
            {locale === 'zh' ? (<p data-l="zh">验收通过，已合并到 <code>main</code>。DeepSeek 的实现和 GPT 的审查都留在提交记录里。</p>) : (<p data-l="en">Accepted and merged to <code>main</code>. The DeepSeek implementation and GPT review both stay in the commit history.</p>)}
          </div>
        </div>
      </div>

      <div class="fd-composer">
        <div class="fd-composer-box">
          <div class="fd-composer-input"><span data-typed></span><span class="fd-caret" aria-hidden="true"></span><span class="fd-placeholder"><span data-l={locale}>{locale === 'zh' ? "输入消息，Enter 发送" : "Message Fynvra…"}</span></span></div>
          <div class="fd-composer-bar">
            <span class="fd-composer-tools">
              <span class="fd-mini-btn" aria-hidden="true"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 5h6M19 2v6" /><path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7.5" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /><circle cx="9" cy="9" r="2" /></svg></span>
              <span class="fd-chip fd-chip-model"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect width="16" height="16" x="4" y="4" rx="2" /><rect width="6" height="6" x="9" y="9" rx="1" /><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" /></svg><span class="fd-chip-label">OpenAI · GPT-5.2 · high</span></span>
              <span class="fd-chip fd-chip-approval"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" /><path d="m8 12 3 3 5-5" /></svg><span data-l={locale}>{locale === 'zh' ? "完全放行" : "Full access"}</span></span>
            </span>
            <span class="fd-send" data-send><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.714 3.048a.498.498 0 0 0-.683.627l2.843 7.627a2 2 0 0 1 0 1.396l-2.842 7.627a.498.498 0 0 0 .682.627l18-8.5a.5.5 0 0 0 0-.904z" /><path d="M6 12h16" /></svg><span data-l={locale}>{locale === 'zh' ? "发送" : "Send"}</span></span>
          </div>
        </div>
      </div>

      <div class="fd-statusbar" aria-hidden="true">
        <span>tokens ↑9.8k ↓2.4k</span><span>$0.03</span>
        <span class="fd-status-right">
          <span class="is-amber"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" /></svg><span data-l={locale}>{locale === 'zh' ? "完全放行" : "Full"}</span></span>
          <span><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4v10a3 3 0 0 0 3 3h9M15 14l3 3-3 3M6 4v4" /></svg>main</span>
          <span>OpenAI · GPT-5.2</span>
        </span>
      </div>
    </div>

    <aside class="fd-panel">
      <div class="fd-panel-head">
        <div class="fd-panel-tabs">
          <span class="fd-panel-tab" data-panel-tab="files">
            <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /></svg>
            <span data-l={locale}>{locale === 'zh' ? "文件" : "Files"}</span>
          </span>
          <span class="fd-panel-tab is-active" data-panel-tab="tasks">
            <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4 6l1 1 2-2M4 12l1 1 2-2M4 18l1 1 2-2" /></svg>
            <span data-l={locale}>{locale === 'zh' ? "任务" : "Tasks"}</span>
            <span class="fd-panel-count" data-task-count hidden>0</span>
          </span>
          <span class="fd-panel-tab">
            <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v12M7 16l-3-3M7 16l3-3M17 20V8M17 8l-3 3M17 8l3 3" /></svg>
            <span data-l={locale}>{locale === 'zh' ? "改动" : "Changes"}</span>
          </span>
        </div>
        <span class="fd-panel-refresh" aria-hidden="true"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2 5.3M20 4v7h-7" /></svg></span>
      </div>

      <div class="fd-panel-body" data-panel-view="files" hidden>
        <p class="fd-tree-group">src/renderer</p>
        <div class="fd-tree-row is-folder"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /></svg><span class="fd-tree-folder">components</span></div>
        <div class="fd-tree-row is-active" style="padding-left: 20px"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z" /><path d="M14 3v6h6" /></svg><span class="fd-tree-folder">Sidebar.tsx</span></div>
        <div class="fd-tree-row" style="padding-left: 20px"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z" /><path d="M14 3v6h6" /></svg><span class="fd-tree-folder">sidebar.css</span></div>
      </div>

      <div class="fd-panel-body" data-panel-view="tasks" hidden>
        <div class="fd-run" data-run data-done="0" data-total="1">
          <div class="fd-run-head">
            <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3" /></svg>
            <span class="fd-run-title"><span data-l={locale}>{locale === 'zh' ? "侧栏折叠与审查" : "Sidebar collapse & review"}</span></span>
            <span class="fd-run-time"><span data-l={locale}>{locale === 'zh' ? "刚刚" : "now"}</span></span>
          </div>
          <div class="fd-progress-row">
            <span class="pg pg-0-1"><span data-l={locale}>{locale === 'zh' ? "已完成 0 / 1" : "0 / 1 done"}</span></span>
            <span class="pg pg-0"><span data-l={locale}>{locale === 'zh' ? "已完成 0 / 2" : "0 / 2 done"}</span></span>
            <span class="pg pg-1"><span data-l={locale}>{locale === 'zh' ? "已完成 1 / 2" : "1 / 2 done"}</span></span>
            <span class="pg pg-2"><span data-l={locale}>{locale === 'zh' ? "已完成 2 / 2" : "2 / 2 done"}</span></span>
            <span class="fd-progress"><i></i></span>
          </div>
        </div>

        <div class="fd-task" data-task="model-impl" data-state="todo" data-appear="3">
          <div class="fd-task-head">
            <span class="fd-task-title"><span data-l={locale}>{locale === 'zh' ? "实现侧栏折叠" : "Implement sidebar collapse"}</span></span>
            <span class="fd-role">Worker</span>
          </div>
          <div class="fd-task-meta">
            <svg class="i" viewBox="0 0 24 24" style="width: 10px; height: 10px" aria-hidden="true"><path d="M6 4v10a3 3 0 0 0 3 3h9M15 14l3 3-3 3M6 4v4" /></svg>
            <code>fynvra/sidebar-collapse</code>
            <span class="fd-model-tag">DeepSeek V4.1</span>
            <span class="fd-status st-todo"><span data-l={locale}>{locale === 'zh' ? "待开始" : "To do"}</span></span>
            <span class="fd-status st-run"><span data-l={locale}>{locale === 'zh' ? "进行中" : "Running"}</span></span>
            <span class="fd-status st-review"><span data-l={locale}>{locale === 'zh' ? "待验收" : "In review"}</span></span>
            <span class="fd-status st-done"><span data-l={locale}>{locale === 'zh' ? "已完成" : "Completed"}</span></span>
          </div>
        </div>

        <div class="fd-task" data-task="model-review" data-state="todo" data-appear="4">
          <div class="fd-task-head">
            <span class="fd-task-title"><span data-l={locale}>{locale === 'zh' ? "审查侧栏改动" : "Review sidebar diff"}</span></span>
            <span class="fd-role">Worker</span>
          </div>
          <div class="fd-task-meta">
            <svg class="i" viewBox="0 0 24 24" style="width: 10px; height: 10px" aria-hidden="true"><path d="M6 4v10a3 3 0 0 0 3 3h9M15 14l3 3-3 3M6 4v4" /></svg>
            <code>fynvra/sidebar-review</code>
            <span class="fd-model-tag">GPT-5.2</span>
            <span class="fd-status st-todo"><span data-l={locale}>{locale === 'zh' ? "待实现" : "Awaiting diff"}</span></span>
            <span class="fd-status st-run"><span data-l={locale}>{locale === 'zh' ? "进行中" : "Running"}</span></span>
            <span class="fd-status st-review"><span data-l={locale}>{locale === 'zh' ? "待验收" : "In review"}</span></span>
            <span class="fd-status st-done"><span data-l={locale}>{locale === 'zh' ? "已完成" : "Completed"}</span></span>
          </div>
        </div>

        <p class="fd-tasks-note" data-appear="4">
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg>
          <span data-l={locale}>{locale === 'zh' ? "模型标签来自输入框里的任务指令" : "Model tags come from the request in the composer"}</span>
        </p>
      </div>
    </aside>
  </div>
</div>
