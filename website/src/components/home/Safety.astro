---
import type { Locale } from '../../content/home/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="section" id="safety">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow"><b>02</b><span data-l={locale}>{locale === 'zh' ? "安全边界" : "Guardrails"}</span></p>
      <h2 class="section-title">
        <span data-l={locale}>{locale === 'zh' ? "放手让它干，底线不让步。" : "Let it run. Keep the guardrails."}</span>
      </h2>
      <p class="section-lead" data-l={locale}>{locale === 'zh' ? "权限按你的角色配置执行，改了提示词也绕不过去。" : "Permissions follow your role settings — no prompt can talk its way around them."}</p>
    </header>

    <div class="safety">
      <div class="table-scroll reveal">
        <table class="matrix">
          <thead>
            <tr>
              <th scope="col"><span data-l={locale}>{locale === 'zh' ? "操作" : "Action"}</span></th>
              <th scope="col"><span data-l={locale}>{locale === 'zh' ? "全程审批" : "Supervised"}</span></th>
              <th scope="col"><span data-l={locale}>{locale === 'zh' ? "自动接受编辑" : "Auto-accept edits"}</span></th>
              <th scope="col"><span data-l={locale}>{locale === 'zh' ? "完全放行" : "Full access"}</span></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">
                <span data-l={locale}>{locale === 'zh' ? "执行命令" : "Commands"}</span>
              </th>
              <td><span class="mark mark-ask"><span data-l={locale}>{locale === 'zh' ? "需确认" : "Ask"}</span></span></td>
              <td><span class="mark mark-ask"><span data-l={locale}>{locale === 'zh' ? "需确认" : "Ask"}</span></span></td>
              <td><span class="mark mark-auto"><span data-l={locale}>{locale === 'zh' ? "自动" : "Auto"}</span></span></td>
            </tr>
            <tr>
              <th scope="row">
                <span data-l={locale}>{locale === 'zh' ? "写改文件" : "File writes"}</span>
              </th>
              <td><span class="mark mark-ask"><span data-l={locale}>{locale === 'zh' ? "需确认" : "Ask"}</span></span></td>
              <td><span class="mark mark-auto"><span data-l={locale}>{locale === 'zh' ? "自动" : "Auto"}</span></span></td>
              <td><span class="mark mark-auto"><span data-l={locale}>{locale === 'zh' ? "自动" : "Auto"}</span></span></td>
            </tr>
            <tr>
              <th scope="row">
                <span data-l={locale}>{locale === 'zh' ? "MCP 工具" : "MCP tools"}</span>
              </th>
              <td><span class="mark mark-ask"><span data-l={locale}>{locale === 'zh' ? "需确认" : "Ask"}</span></span></td>
              <td><span class="mark mark-ask"><span data-l={locale}>{locale === 'zh' ? "需确认" : "Ask"}</span></span></td>
              <td><span class="mark mark-auto"><span data-l={locale}>{locale === 'zh' ? "自动" : "Auto"}</span></span></td>
            </tr>
            <tr class="row-floor">
              <th scope="row">
                <span data-l={locale}>{locale === 'zh' ? "保护操作" : "Protected"}</span>
                <small>rm -rf · git push · git reset --hard · publish</small>
              </th>
              <td><span class="mark mark-always"><span data-l={locale}>{locale === 'zh' ? "始终确认" : "Always ask"}</span></span></td>
              <td><span class="mark mark-always"><span data-l={locale}>{locale === 'zh' ? "始终确认" : "Always ask"}</span></span></td>
              <td><span class="mark mark-always"><span data-l={locale}>{locale === 'zh' ? "始终确认" : "Always ask"}</span></span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="guards reveal">
        <p class="guards-title">
          <span class="spec-kicker"
            ><span data-l={locale}>{locale === 'zh' ? "运行时护栏" : "Runtime guardrails"}</span></span
          >
        </p>
        <div class="guard">
          <span class="guard-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="7.5" cy="15.5" r="4.5" />
              <path d="M10.7 12.3 21 2M17 6l3 3M14 9l2.5 2.5" />
            </svg>
          </span>
          <div>
            <h3><span data-l={locale}>{locale === 'zh' ? "密钥本地保存" : "Keys stored locally"}</span></h3>
            <p data-l={locale}>{locale === 'zh' ? "API Key 保存在本地配置文件里，不是加密凭证库，请不要把应用数据目录分享给别人。" : "API keys live in local config files — not an encrypted vault — so don't share your app data folder."}</p>
          </div>
        </div>
        <div class="guard">
          <span class="guard-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="13" r="8" />
              <path d="M12 9v4l2.5 2.5M9 2h6" />
            </svg>
          </span>
          <div>
            <h3><span data-l={locale}>{locale === 'zh' ? "没人回应，就是拒绝" : "Silence means no"}</span></h3>
            <p data-l={locale}>{locale === 'zh' ? "审批请求 10 分钟没有答复，或回合被中止，一律按拒绝处理。" : "Approval requests left unanswered for 10 minutes, or cut off by an aborted turn, are denied."}</p>
          </div>
        </div>
        <div class="guard">
          <span class="guard-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="4" y="10" width="16" height="11" rx="2" />
              <path d="M8 10V7a4 4 0 0 1 8 0v3" />
            </svg>
          </span>
          <div>
            <h3><span data-l={locale}>{locale === 'zh' ? "文件访问有围栏" : "Fenced file access"}</span></h3>
            <p data-l={locale}>{locale === 'zh' ? "内置文件工具只读写已挂入的工作区。" : "Built-in file tools read and write only within attached workspaces."}</p>
          </div>
        </div>
        <div class="guard">
          <span class="guard-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="12" rx="2" />
              <path d="M2 20h20" />
            </svg>
          </span>
          <div>
            <h3><span data-l={locale}>{locale === 'zh' ? "本地运行，直连服务" : "Local, with direct connections"}</span></h3>
            <p data-l={locale}>{locale === 'zh' ? "Fynvra 没有中转服务器，对话请求只发往你配置的模型服务地址。" : "There is no relay server; prompts go only to the endpoints you configure."}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
