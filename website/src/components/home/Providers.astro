---
import type { Locale } from '../../content/home/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="strip" aria-label={locale === 'zh' ? '模型服务' : 'Providers'}>
  <div class="container strip-inner">
    <!--
      品牌图标：Anthropic / OpenAI / Google Gemini / DeepSeek / Qwen 取自 Simple Icons（https://simpleicons.org，CC0-1.0）；
      xAI 取自 xAI 官方标识（X.AI Corp.，公有领域 PD-textlogo，商标归 xAI），经 Wikimedia Commons 本地化。
      均无运行时远端请求。滚动轨道第 2、3 份副本只用于无缝循环，已对辅助技术隐藏。
    -->
    <div class="providers">
      <p class="providers-title" id="providers-title"><span data-l={locale}>{locale === 'zh' ? "模型服务" : "Model providers"}</span></p>
      <!-- biome-ignore lint/a11y/noNoninteractiveTabindex: Keyboard focus pauses the scrolling region via :focus-within. -->
      <section class="providers-marquee" tabindex="0" aria-labelledby="providers-title">
        <div class="providers-viewport">
          <div class="providers-track">
            <ul class="providers-set">
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/anthropic.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">Anthropic</span>
              </li>
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/openai.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">OpenAI</span>
              </li>
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/google-gemini.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">Google Gemini</span>
              </li>
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/deepseek.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">DeepSeek</span>
              </li>
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/qwen.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">Qwen</span>
              </li>
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/xai.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">xAI</span>
              </li>
            </ul>
            <ul class="providers-set" aria-hidden="true">
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/anthropic.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">Anthropic</span>
              </li>
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/openai.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">OpenAI</span>
              </li>
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/google-gemini.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">Google Gemini</span>
              </li>
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/deepseek.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">DeepSeek</span>
              </li>
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/qwen.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">Qwen</span>
              </li>
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/xai.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">xAI</span>
              </li>
            </ul>
            <ul class="providers-set" aria-hidden="true">
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/anthropic.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">Anthropic</span>
              </li>
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/openai.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">OpenAI</span>
              </li>
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/google-gemini.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">Google Gemini</span>
              </li>
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/deepseek.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">DeepSeek</span>
              </li>
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/qwen.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">Qwen</span>
              </li>
              <li class="provider">
                <img class="provider-mark" src="/assets/providers/xai.svg" alt="" width="30" height="30" aria-hidden="true" />
                <span class="provider-name">xAI</span>
              </li>
            </ul>
          </div>
        </div>
      </section>
    </div>

    <div class="strip-row">
      <p class="strip-label"><span data-l={locale}>{locale === 'zh' ? "配置导入" : "Import from"}</span></p>
      <ul class="strip-list strip-list-muted">
        <li>Claude Code</li>
        <li>Codex</li>
        <li>CC Switch</li>
        <li>Cursor</li>
        <li>Gemini CLI</li>
        <li>VS Code</li>
        <li>OpenCode</li>
        <li>Grok CLI</li>
      </ul>
    </div>
  </div>
</section>
