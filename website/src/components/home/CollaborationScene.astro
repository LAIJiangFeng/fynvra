---
import type { Locale } from '../../content/home/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="fd-scene" id="fd-scene-collab" data-scene="collab" data-phase="0">
<div class="fd-body">
  <aside class="fd-side">
    <div class="fd-side-head">
      <span data-l={locale}>{locale === 'zh' ? "工作区" : "Workspaces"}</span>
      <span class="fd-side-actions" aria-hidden="true">
        <span class="fd-mini-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
      </span>
    </div>

    <div class="fd-workspace">
      <div class="fd-ws-row">
        <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /></svg>
        <span>fynvra</span><span class="fd-ws-branch">main</span>
      </div>
      <p class="fd-ws-path">D:\project\fynvra</p>

      <div class="fd-sessions-head">
        <span data-l={locale}>{locale === 'zh' ? "会话" : "Sessions"}</span>
        <span class="fd-side-actions" aria-hidden="true">
          <span class="fd-mini-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4-4" /></svg></span>
          <span class="fd-mini-btn"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
        </span>
      </div>

      <div class="fd-session is-active is-idle" data-session="orchestrator">
        <span class="fd-dot is-run"></span>
        <span class="fd-session-main">
          <span class="fd-session-title"><span data-l={locale}>{locale === 'zh' ? "优化首页与文档" : "Homepage & docs"}</span></span>
          <span class="fd-session-sub">
            <span class="fd-role is-orch"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 4 3 5-6 5 6 4-3-2 11H5Z" /></svg>Orchestrator</span>
            <span class="fd-session-time"><span data-l={locale}>{locale === 'zh' ? "刚刚" : "now"}</span></span>
          </span>
        </span>
      </div>

      <div class="fd-session is-idle" data-session="home" data-appear="3">
        <span class="fd-dot is-run"></span>
        <span class="fd-session-main">
          <span class="fd-session-title"><span data-l={locale}>{locale === 'zh' ? "首页：标题与演示" : "Homepage: layout & demo"}</span></span>
          <span class="fd-session-sub">
            <span class="fd-role">Worker</span>
            <span class="fd-session-time"><span data-l={locale}>{locale === 'zh' ? "刚刚" : "now"}</span></span>
          </span>
        </span>
      </div>

      <div class="fd-session is-idle" data-session="docs" data-appear="4">
        <span class="fd-dot is-run"></span>
        <span class="fd-session-main">
          <span class="fd-session-title"><span data-l={locale}>{locale === 'zh' ? "文档：阅读与导航" : "Docs: reading & nav"}</span></span>
          <span class="fd-session-sub">
            <span class="fd-role">Worker</span>
            <span class="fd-session-time"><span data-l={locale}>{locale === 'zh' ? "刚刚" : "now"}</span></span>
          </span>
        </span>
      </div>
    </div>
  </aside>

  <div class="fd-main">
    <div class="fd-editor-tabs" aria-hidden="true">
      <span class="fd-editor-tab is-active"><span data-l={locale}>{locale === 'zh' ? "对话" : "Chat"}</span></span>
      <span class="fd-editor-tab">index.html</span>
      <span class="fd-editor-tab">docs.html</span>
      <span class="fd-editor-add"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
    </div>

    <div class="fd-chat-head is-idle" data-chat-head data-state="done">
      <span class="fd-dot is-run"></span>
      <span class="fd-chat-title"><span data-l={locale}>{locale === 'zh' ? "优化首页与文档" : "Homepage & docs"}</span></span>
      <span class="fd-role is-orch"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 4 3 5-6 5 6 4-3-2 11H5Z" /></svg>Orchestrator</span>
      <span class="fd-chip"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4v10a3 3 0 0 0 3 3h9M15 14l3 3-3 3M6 4v4" /></svg>main</span>
      <span class="fd-chat-status">
        <span class="fd-st-run"><span data-l={locale}>{locale === 'zh' ? "运行中" : "Running"}</span></span>
        <span class="fd-st-idle"><span data-l={locale}>{locale === 'zh' ? "空闲" : "Idle"}</span></span>
      </span>
    </div>

    <div class="fd-timeline" data-timeline>
      <div class="fd-stream">
        <div class="fd-empty" data-empty hidden>
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 0 1-8 8H5l-2 2V12a8 8 0 0 1 8-8h2a8 8 0 0 1 8 8Z" /><path d="M8 11h8M8 15h5" /></svg>
          <span data-l={locale}>{locale === 'zh' ? "说清楚目标，主 Agent 会拆分、派发并验收。" : "Describe the goal. The orchestrator splits, dispatches, and reviews."}</span>
        </div>

        <div class="fd-msg is-user" data-appear="2">
          <span data-l={locale}>{locale === 'zh' ? "优化官网首页：标题收紧一点，把顶部演示改成真实操作流程；文档页交给另一个 Worker。" : "Polish the homepage: smaller title, a real workflow demo. Give the docs page to another worker."}</span>
        </div>

        <div class="fd-msg fd-agent" data-appear="2">
          <p data-l={locale}>{locale === 'zh' ? "收到。两个任务互不依赖：首页只动展示层，文档页单独一套阅读结构。我各开一个 worktree，并行派发。" : "On it. These two are independent: the homepage is presentation-only, and the docs page has its own reading shell. I'll open a worktree for each and dispatch them in parallel."}</p>
        </div>

        <div class="fd-tool" data-appear="3">
          <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg>
          <span class="fd-tool-label"><span data-l={locale}>{locale === 'zh' ? "派发任务" : "Dispatch task"}</span></span>
          <span class="fd-tool-title"><span data-l={locale}>{locale === 'zh' ? "首页：收紧标题，重做操作演示" : "Homepage: tighten title, rebuild demo"}</span></span>
          <span class="fd-role">Worker</span>
          <code class="fd-tool-branch">fynvra/home-demo</code>
          <span class="fd-tool-meta"><span>0.4s</span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === 'zh' ? '已完成' : 'Completed'}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg><svg class="i is-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span>
        </div>

        <div class="fd-tool" data-appear="4">
          <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg>
          <span class="fd-tool-label"><span data-l={locale}>{locale === 'zh' ? "派发任务" : "Dispatch task"}</span></span>
          <span class="fd-tool-title"><span data-l={locale}>{locale === 'zh' ? "文档：统一阅读节奏与导航" : "Docs: unify reading rhythm and nav"}</span></span>
          <span class="fd-role">Worker</span>
          <code class="fd-tool-branch">fynvra/docs-nav</code>
          <span class="fd-tool-meta"><span>0.5s</span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === 'zh' ? '已完成' : 'Completed'}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg><svg class="i is-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span>
        </div>

        <div class="fd-msg fd-agent" data-appear="5">
          <p data-l={locale}>{locale === 'zh' ? "两个 Worker 已经在各自的分支和目录里改文件，互不踩踏。首页任务先回来。" : "Both workers are editing their own branch and directory, so they can't collide. The homepage task reports first."}</p>
        </div>

        <div class="fd-tool" data-appear="6">
          <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h10M4 19h7" /><path d="m17 15 3 3-3 3M20 18h-7" /></svg>
          <span class="fd-tool-label"><span data-l={locale}>{locale === 'zh' ? "审查改动" : "Review diff"}</span></span>
          <span class="fd-tool-title"><span data-l={locale}>{locale === 'zh' ? "首页 · 4 个文件" : "Homepage · 4 files"}</span></span>
          <code>+86 −54</code>
          <span class="fd-tool-meta"><span>1.1s</span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === 'zh' ? '已完成' : 'Completed'}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg><svg class="i is-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span>
        </div>

        <div class="fd-tool" data-appear="7">
          <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2" /><path d="m8 12 2.5 2.5L16 9" /></svg>
          <span class="fd-tool-label"><span data-l={locale}>{locale === 'zh' ? "运行检查" : "Run checks"}</span></span>
          <span class="fd-tool-title"><code>git diff --check · node --check</code></span>
          <span class="fd-tool-meta"><span>2.4s</span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === 'zh' ? '已完成' : 'Completed'}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg><svg class="i is-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span>
        </div>

        <div class="fd-tool" data-appear="7">
          <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="5" r="2" /><circle cx="18" cy="5" r="2" /><circle cx="12" cy="19" r="2" /><path d="M6 7v3a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7M12 12v5" /></svg>
          <span class="fd-tool-label"><span data-l={locale}>{locale === 'zh' ? "合并分支" : "Merge branch"}</span></span>
          <span class="fd-tool-title"><code>fynvra/home-demo → main</code></span>
          <span class="fd-tool-meta"><span class="fd-ok"><span data-l={locale}>{locale === 'zh' ? "已合并" : "Merged"}</span></span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === 'zh' ? '已完成' : 'Completed'}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg></span>
        </div>

        <div class="fd-tool" data-appear="8">
          <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h10M4 19h7" /><path d="m17 15 3 3-3 3M20 18h-7" /></svg>
          <span class="fd-tool-label"><span data-l={locale}>{locale === 'zh' ? "审查改动" : "Review diff"}</span></span>
          <span class="fd-tool-title"><span data-l={locale}>{locale === 'zh' ? "文档 · 3 个文件" : "Docs · 3 files"}</span></span>
          <code>+128 −39</code>
          <span class="fd-tool-meta"><span>1.3s</span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === 'zh' ? '已完成' : 'Completed'}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg><svg class="i is-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></span>
        </div>

        <div class="fd-tool" data-appear="9">
          <svg class="i fd-tool-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="5" r="2" /><circle cx="18" cy="5" r="2" /><circle cx="12" cy="19" r="2" /><path d="M6 7v3a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7M12 12v5" /></svg>
          <span class="fd-tool-label"><span data-l={locale}>{locale === 'zh' ? "合并分支" : "Merge branch"}</span></span>
          <span class="fd-tool-title"><code>fynvra/docs-nav → main</code></span>
          <span class="fd-tool-meta"><span class="fd-ok"><span data-l={locale}>{locale === 'zh' ? "已合并" : "Merged"}</span></span><svg class="i is-ok" viewBox="0 0 24 24"><title>{locale === 'zh' ? '已完成' : 'Completed'}</title><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></svg></span>
        </div>

        <div class="fd-msg fd-agent" data-appear="9">
          {locale === 'zh' ? (<p data-l="zh">两个任务都通过检查并合并。<code>main</code> 上是两条 <code>--no-ff</code> 提交，首页和文档的改动都能逐文件回看。</p>) : (<p data-l="en">Both tasks passed checks and merged. <code>main</code> has two <code>--no-ff</code> commits, and both diffs stay reviewable file by file.</p>)}
        </div>
      </div>
    </div>

    <div class="fd-composer">
      <div class="fd-composer-box">
        <div class="fd-composer-input"><span data-typed></span><span class="fd-caret" aria-hidden="true"></span><span class="fd-placeholder"><span data-l={locale}>{locale === 'zh' ? "输入消息，Enter 发送" : "Message Fynvra…"}</span></span></div>
        <div class="fd-composer-bar">
          <span class="fd-composer-tools">
            <span class="fd-mini-btn" aria-hidden="true"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 5h6M19 2v6" /><path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7.5" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /><circle cx="9" cy="9" r="2" /></svg></span>
            <span class="fd-chip fd-chip-model"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect width="16" height="16" x="4" y="4" rx="2" /><rect width="6" height="6" x="9" y="9" rx="1" /><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" /></svg><span class="fd-chip-label">deepseek-v4.1-flash · high</span></span>
            <span class="fd-chip fd-chip-approval"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" /><path d="m8 12 3 3 5-5" /></svg><span data-l={locale}>{locale === 'zh' ? "完全放行" : "Full access"}</span></span>
          </span>
          <span class="fd-send" data-send><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.714 3.048a.498.498 0 0 0-.683.627l2.843 7.627a2 2 0 0 1 0 1.396l-2.842 7.627a.498.498 0 0 0 .682.627l18-8.5a.5.5 0 0 0 0-.904z" /><path d="M6 12h16" /></svg><span data-l={locale}>{locale === 'zh' ? "发送" : "Send"}</span></span>
        </div>
      </div>
    </div>

    <div class="fd-statusbar" aria-hidden="true">
      <span>tokens ↑18.6k ↓4.2k</span><span>$0.06</span>
      <span class="fd-status-right">
        <span class="is-amber"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6Z" /></svg><span data-l={locale}>{locale === 'zh' ? "完全放行" : "Full"}</span></span>
        <span><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4v10a3 3 0 0 0 3 3h9M15 14l3 3-3 3M6 4v4" /></svg>main</span>
        <span>deepseek-v4.1-flash</span>
      </span>
    </div>
  </div>

  <aside class="fd-panel">
    <div class="fd-panel-head">
      <div class="fd-panel-tabs">
        <span class="fd-panel-tab" data-panel-tab="files">
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /></svg>
          <span data-l={locale}>{locale === 'zh' ? "文件" : "Files"}</span>
        </span>
        <span class="fd-panel-tab is-active" data-panel-tab="tasks">
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4 6l1 1 2-2M4 12l1 1 2-2M4 18l1 1 2-2" /></svg>
          <span data-l={locale}>{locale === 'zh' ? "任务" : "Tasks"}</span>
          <span class="fd-panel-count" data-task-count>2</span>
        </span>
        <span class="fd-panel-tab">
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v12M7 16l-3-3M7 16l3-3M17 20V8M17 8l-3 3M17 8l3 3" /></svg>
          <span data-l={locale}>{locale === 'zh' ? "改动" : "Changes"}</span>
        </span>
      </div>
      <span class="fd-panel-refresh" aria-hidden="true"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2 5.3M20 4v7h-7" /></svg></span>
    </div>

    <div class="fd-panel-body" data-panel-view="files" hidden>
      <p class="fd-tree-group">fynvra</p>
      <div class="fd-tree-row is-folder"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /></svg><span class="fd-tree-folder">website</span></div>
      <div class="fd-tree-row is-active" style="padding-left: 20px"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z" /><path d="M14 3v6h6" /></svg><span class="fd-tree-folder">index.html</span></div>
      <div class="fd-tree-row" style="padding-left: 20px"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z" /><path d="M14 3v6h6" /></svg><span class="fd-tree-folder">docs.html</span></div>
      <div class="fd-tree-row is-folder" style="padding-left: 20px"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /></svg><span class="fd-tree-folder">assets</span></div>
      <div class="fd-tree-row" style="padding-left: 36px"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z" /><path d="M14 3v6h6" /></svg><span class="fd-tree-folder">site.css</span></div>
      <div class="fd-tree-row" style="padding-left: 36px"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z" /><path d="M14 3v6h6" /></svg><span class="fd-tree-folder">home.css</span></div>
      <div class="fd-tree-row" style="padding-left: 36px"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z" /><path d="M14 3v6h6" /></svg><span class="fd-tree-folder">home.js</span></div>
      <div class="fd-tree-row is-folder"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /></svg><span class="fd-tree-folder">src</span></div>
      <div class="fd-tree-row"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z" /><path d="M14 3v6h6" /></svg><span class="fd-tree-folder">package.json</span></div>
    </div>

    <div class="fd-panel-body" data-panel-view="tasks">
      <div class="fd-run" data-run data-done="2" data-total="2">
        <div class="fd-run-head">
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3" /></svg>
          <span class="fd-run-title"><span data-l={locale}>{locale === 'zh' ? "优化首页与文档" : "Homepage & docs"}</span></span>
          <span class="fd-run-time"><span data-l={locale}>{locale === 'zh' ? "刚刚" : "now"}</span></span>
        </div>
        <div class="fd-progress-row">
          <span class="pg pg-0-1"><span data-l={locale}>{locale === 'zh' ? "已完成 0 / 1" : "0 / 1 done"}</span></span>
          <span class="pg pg-0"><span data-l={locale}>{locale === 'zh' ? "已完成 0 / 2" : "0 / 2 done"}</span></span>
          <span class="pg pg-1"><span data-l={locale}>{locale === 'zh' ? "已完成 1 / 2" : "1 / 2 done"}</span></span>
          <span class="pg pg-2"><span data-l={locale}>{locale === 'zh' ? "已完成 2 / 2" : "2 / 2 done"}</span></span>
          <span class="fd-progress"><i></i></span>
        </div>
      </div>

      <div class="fd-task" data-task="home" data-state="done" data-appear="3">
        <div class="fd-task-head">
          <span class="fd-task-title"><span data-l={locale}>{locale === 'zh' ? "首页：收紧标题，重做操作演示" : "Homepage: tighten title, rebuild demo"}</span></span>
          <span class="fd-role">Worker</span>
